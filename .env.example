# ==============================================================================
# Nepal Telecom Corporation (NTC) — Darta-Chalan Digitization System
# Environment Configuration Template (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. System & Server Settings
# ------------------------------------------------------------------------------
PROJECT_NAME="Nepal Telecom Darta-Chalan Digitization System"
VERSION=1.0.0
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000
# Set FRONTEND_PORT=80 if you want direct access on standard HTTP port without typing :3000
FRONTEND_PORT=3000
# DB_PORT maps container PostgreSQL (5432) to host port 5433 to avoid conflict with local postgres
DB_PORT=5433

# SSL / HTTPS & Domain Configuration:
# Set SSL_ENABLED=true to run in secure HTTPS mode (or pass --ssl flag to run_app.py)
SSL_ENABLED=false
# Custom Domain Name (e.g. darta.ntc.net.np or darta.local or your registered domain)
DOMAIN_NAME=
# Public HTTP/HTTPS ports (defaults: 80 and 443)
HTTP_PORT=80
HTTPS_PORT=443

# ------------------------------------------------------------------------------
# 2. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_DB=darta_chalan_db
POSTGRES_USER=ntc_admin
POSTGRES_PASSWORD=ntc_secure_password_2081
POSTGRES_PORT=5432
# Inside Docker Compose, hostname is "db":
DATABASE_URL=postgresql+psycopg2://ntc_admin:ntc_secure_password_2081@db:5432/darta_chalan_db

# ------------------------------------------------------------------------------
# 3. Security & JWT Authentication
# ------------------------------------------------------------------------------
# Generate a cryptographically secure key for production:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_KEY_IN_PRODUCTION
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_HOURS=24

# ------------------------------------------------------------------------------
# 4. Storage & File Uploads
# ------------------------------------------------------------------------------
UPLOAD_DIR=/app/storage/uploads
MAX_UPLOAD_SIZE_MB=25

# ------------------------------------------------------------------------------
# 5. OCR (Optical Character Recognition) Engine
# ------------------------------------------------------------------------------
# Inside Docker, Tesseract is pre-installed at /usr/bin/tesseract:
TESSERACT_CMD=/usr/bin/tesseract

# ------------------------------------------------------------------------------
# 6. Inbound SMTP Scanner Service (Scan-to-Email / Multi-Function Printers)
# ------------------------------------------------------------------------------
SMTP_SCANNER_ENABLED=true
SMTP_SCANNER_HOST=0.0.0.0
SMTP_SCANNER_PORT=1025
SMTP_SCANNER_MAX_MESSAGE_MB=25
SMTP_SCANNER_ALLOWED_DOMAINS=ntc.net.np,gov.np
SMTP_SCANNER_DEFAULT_OFFICE_ID=1

# ------------------------------------------------------------------------------
# 7. Outbound Email Notifications (SMTP)
# ------------------------------------------------------------------------------
OUTBOUND_EMAIL_ENABLED=false
OUTBOUND_SMTP_HOST=smtp.ntc.net.np
OUTBOUND_SMTP_PORT=587
OUTBOUND_SMTP_USER=
OUTBOUND_SMTP_PASSWORD=
OUTBOUND_SMTP_FROM=darta@ntc.net.np
OUTBOUND_SMTP_USE_TLS=true

# ------------------------------------------------------------------------------
# 8. CORS Origins
# ------------------------------------------------------------------------------
CORS_ORIGINS=["*"]
