# ==============================================================================
# Nepal Telecom Corporation (NTC) — Darta-Chalan Digitization System
# Environment Configuration Template (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. System & Server Settings
# ------------------------------------------------------------------------------
PROJECT_NAME="Nepal Telecom Darta-Chalan Digitization System"
VERSION=1.0.0
ENVIRONMENT=production
DEBUG=false
HOST=0.0.0.0
PORT=8000

# ------------------------------------------------------------------------------
# 2. Database Configuration
# ------------------------------------------------------------------------------
# Default development / standalone SQLite:
DATABASE_URL=sqlite:///./digitization.db

# Production PostgreSQL example:
# DATABASE_URL=postgresql://ntc_admin:StrongPassword123@localhost:5432/darta_chalan_prod

# ------------------------------------------------------------------------------
# 3. Security & JWT Authentication
# ------------------------------------------------------------------------------
# IMPORTANT: Generate a cryptographically secure key for production:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_KEY_IN_PRODUCTION
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_HOURS=24

# ------------------------------------------------------------------------------
# 4. Storage & File Uploads
# ------------------------------------------------------------------------------
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_SIZE_MB=25

# ------------------------------------------------------------------------------
# 5. OCR (Optical Character Recognition) Engine
# ------------------------------------------------------------------------------
# Windows path example: C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux / Docker path example: /usr/bin/tesseract
# Leave blank to auto-detect from system PATH:
TESSERACT_CMD=

# ------------------------------------------------------------------------------
# 6. Inbound SMTP Scanner Service (Scan-to-Email / Multi-Function Printers)
# ------------------------------------------------------------------------------
# Enables the asynchronous RFC 5321 ESMTP listener to ingest scanned documents
# directly from network scanners (Canon imageRUNNER, HP, Ricoh, Xerox) and emails.
SMTP_SCANNER_ENABLED=true
SMTP_SCANNER_HOST=0.0.0.0
# Port 1025 for development/unprivileged user; use 25 for production SMTP with root/bind capability
SMTP_SCANNER_PORT=1025
SMTP_SCANNER_MAX_MESSAGE_MB=25
# Optional comma-separated list of allowed recipient domains (empty allows all incoming scans):
SMTP_SCANNER_ALLOWED_DOMAINS=ntc.net.np,gov.np
# Default office ID to attribute incoming scans if not specified in headers:
SMTP_SCANNER_DEFAULT_OFFICE_ID=1

# ------------------------------------------------------------------------------
# 7. Outbound SMTP / Email Notifications (Optional)
# ------------------------------------------------------------------------------
OUTBOUND_EMAIL_ENABLED=false
OUTBOUND_SMTP_HOST=smtp.ntc.net.np
OUTBOUND_SMTP_PORT=587
OUTBOUND_SMTP_USER=darta-alerts@ntc.net.np
OUTBOUND_SMTP_PASSWORD=
OUTBOUND_SMTP_FROM=darta@ntc.net.np
OUTBOUND_SMTP_USE_TLS=true

# ------------------------------------------------------------------------------
# 8. CORS Origins (Cross-Origin Resource Sharing)
# ------------------------------------------------------------------------------
# JSON list of allowed origins. Use ["*"] for open access or specify frontend URLs:
CORS_ORIGINS=["*"]
